# Credenciales de Supabase (cópialo a un archivo .env y rellena los valores).
# El .env NO se sube al repo (está en .gitignore). La "anon key" es pública
# (vive en el frontend); la "service_role" NUNCA va aquí ni en el código.

# URL del proyecto, SIN /rest/v1 al final. Ej: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave pública "anon" (Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=

# ───────── Server (Vercel Functions: /api/*) — NO van con prefijo VITE_ ─────────
# Configúralas en Vercel -> Project Settings -> Environment Variables.
# NUNCA pongas estas en el código del cliente: solo viven en el servidor.

# Supabase (servidor)
SUPABASE_URL=
# Service role key (FULL ACCESS — solo en server). Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (modo TEST primero — claves sk_test_/whsec_/price_test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
